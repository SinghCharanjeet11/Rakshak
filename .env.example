# Copy to .env and fill in. Never commit the real .env.

# --- backend ---
# Only llm/_provider.py reads this. Leave it blank and Rakshak still works: structured
# JSON verifies fully, and free-text parsing returns 502 with a "submit JSON" hint.
OPENAI_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini

# Postgres only. Neon: copy the POOLED connection string (host contains `-pooler`)
# and keep ?sslmode=require. The store refuses any non-Postgres URL.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.ap-south-1.aws.neon.tech/neondb?sslmode=require
# Schema to use. Tests override this to a throwaway schema and DROP it afterwards.
DB_SCHEMA=public

# Tenant auth. Blank = open mode (single-tenant demo; the X-Tenant-Id header is advisory).
# Set `key:tenant` pairs and the key becomes the only way to name a tenant — the header is
# then ignored, and a cross-tenant read returns 404 rather than 403.
# API_KEYS=sk_acme:acme,sk_globex:globex
API_KEYS=
ACTIVE_RULEPACK=2026.04.21-1
FRONTEND_ORIGIN=http://localhost:3000

# base | weighted  (severity-weighted scoring is the SHOULD-tier variant)
SCORING_MODE=base

# --- per-run budget caps (a run that would exceed one halts, it does not overrun) ---
BUDGET_MAX_TURNS=25
BUDGET_MAX_TOTAL_TURNS=60
BUDGET_MAX_TOKENS=40000
BUDGET_MAX_COST_INR=5.0
BUDGET_MAX_ACTIONS=500

# --- frontend ---
# Only NEXT_PUBLIC_* values reach the browser. The model key must never be among them.
NEXT_PUBLIC_API_BASE=http://localhost:8000/api/v1
